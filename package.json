{
  "name": "que",
  "version": "0.1.0",
  "description": "Local personal media library and video/music player",
  "main": "./out/main/index.js",
  "author": "Ang",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs --soft-fail && node scripts/fetch-ffmpeg.mjs --if-missing --soft-fail",
    "fetch:electron": "node scripts/ensure-electron.mjs",
    "check:electron": "node scripts/ensure-electron.mjs --check",
    "predev": "node scripts/ensure-electron.mjs",
    "dev": "electron-vite dev",
    "prestart": "node scripts/ensure-electron.mjs",
    "start": "electron-vite preview",
    "prebuild": "node scripts/ensure-electron.mjs",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && electron-builder --win",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "clean": "node scripts/clean.mjs",
    "clean:all": "node scripts/clean.mjs --all",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,scripts,tests}/**/*.{ts,tsx,js,mjs,css,json}\" \"*.{json,yml,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:skins": "vitest run tests/skins",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:path": "node scripts/db-cli.mjs path",
    "db:migrate": "node scripts/db-cli.mjs migrate",
    "db:reset": "node scripts/db-cli.mjs reset",
    "db:reindex": "node scripts/db-cli.mjs reindex",
    "db:vacuum": "node scripts/db-cli.mjs vacuum",
    "db:stats": "node scripts/db-cli.mjs stats"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
}
